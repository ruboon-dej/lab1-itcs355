{
  "uid": "itcs355",
  "title": "ITCS355 \u2014 Prediction service",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "",
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate by class",
      "description": "Share of all requests that were 4xx or 5xx. `on() group_left` is needed: the numerator has a status_class label, the denominator has none, so a plain division matches nothing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(http_requests_total{status_class=~\"4xx|5xx\"}[1m])) / on() group_left sum(rate(http_requests_total[1m]))",
          "legendFormat": "{{status_class}}",
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "If p99 is far above p95 in a repeating pattern, suspect cold start or a per-request model load.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(request_latency_ms_bucket[5m])))",
          "legendFormat": "p50",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(request_latency_ms_bucket[5m])))",
          "legendFormat": "p95",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(request_latency_ms_bucket[5m])))",
          "legendFormat": "p99",
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Feature drift (PSI per feature, latest scheduled check)",
      "description": "Written by monitoring/drift.py (--pushgateway locally, --emit to Azure Monitor in CI). Alert threshold is in reports/drift_threshold.json.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "drift_psi",
          "legendFormat": "{{feature}}",
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Model version in production",
      "description": "Shows the version label itself (the metric value is always 1).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "model_version_info",
          "legendFormat": "{{version}}",
          "instant": true
        }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Input rolling mean: temp_c (last 500 requests)",
      "description": "Feature-distribution statistic computed inside the service over a rolling window. One feature, because features with very different scales cannot share an axis.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "feature_rolling_mean{feature=\"temp_c\"}",
          "legendFormat": "{{feature}}",
          "instant": false
        }
      ]
    }
  ]
}
